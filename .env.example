# Server Configuration
PORT=3000

# Anthropic Claude API Key (Required for AI reasoning & financial tips)
# Model: claude-3-5-sonnet-20241022 or claude-sonnet-4-6
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheets Service Account Credentials
# Paste either the raw JSON string OR absolute file path to your service account key file
GOOGLE_SERVICE_ACCOUNT_JSON=your_service_account_json_or_file_path_here

# Google Spreadsheet ID (from the sheet URL: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit)
SPREADSHEET_ID=your_google_spreadsheet_id_here
